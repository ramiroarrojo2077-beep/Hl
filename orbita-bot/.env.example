# Node 24+. Ollama es local; requiere instalar y descargar un modelo con herramientas.
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Para usar xAI cambia MODEL_PROVIDER=xai. La clave nunca se envía al navegador.
XAI_API_KEY=
# Verifica la disponibilidad del modelo en tu cuenta de xAI.
XAI_MODEL=grok-4.7
PORT=3000
HOST=127.0.0.1
# Para APK: HOST=0.0.0.0, clave aleatoria de al menos 32 caracteres y hosts exactos.
ORBITA_ACCESS_TOKEN=
# Ejemplo: bots.tudominio.com,192.168.1.20:3000,10.0.2.2:3000
ALLOWED_HOSTS=
APP_ORIGINS=https://localhost,capacitor://localhost
# Navegación bloqueada hasta definir dominios exactos separados por comas.
BROWSER_ALLOWED_HOSTS=
ORBITA_TERMINAL_IMAGE=orbita-computer:local
