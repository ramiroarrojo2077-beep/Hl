# Imagen de referencia (no ejecutada en el entorno donde se desarrolló).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY server ./server
COPY src/geo ./src/geo
EXPOSE 8787
CMD ["node", "server/index.ts"]
