# ---------------------------------------------------------------- Servidor (Node)
# Clave de la API de Anthropic para el asistente con IA (sin ella funciona el modo básico).
ANTHROPIC_API_KEY=
# EARTH_AI_MODEL=claude-opus-5-5
# EARTH_AI_EFFORT=medium            # low | medium | high | xhigh | max
# PORT=8787
# PostgreSQL + PostGIS opcional para lugares compartidos y capas en el servidor.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/earthnext
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# EARTH_USER_AGENT=EarthNext/0.1 (+https://tu-dominio)
# Si el servidor sale a Internet por un proxy HTTP(S):
# NODE_USE_ENV_PROXY=1

# ---------------------------------------------------------------- Cliente (Vite, se incrustan en el build)
# Opcionales: también se pueden cargar desde Ajustes → Claves en el navegador.
# VITE_CESIUM_ION_TOKEN=
# VITE_GOOGLE_MAPS_KEY=
# VITE_MAPILLARY_TOKEN=
# VITE_OSRM_URL=https://router.project-osrm.org
# VITE_API_BASE=
