{
  "name": "earth-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EARTH NEXT: plataforma geoespacial 3D (CesiumJS + datos abiertos + IA)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "check": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@preact/signals": "^2.11.4",
    "cesium": "^1.147.0",
    "jszip": "^3.10.2",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
