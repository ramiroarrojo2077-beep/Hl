# Modelo de IA: con clave de Anthropic se usa Claude (https://platform.claude.com/settings/keys).
ANTHROPIC_API_KEY=

# Gratis, sin Anthropic: Google Gemini (clave gratis en https://aistudio.google.com/apikey)
# y, si se acaba su cupo, el mejor modelo gratis de OpenRouter (clave gratis en https://openrouter.ai/settings/keys).
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GRAVITY_GEMINI_MODELOS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest,gemini-2.5-flash-lite
# GRAVITY_RESPALDO_MODELO=   # vacío = elige solo el mejor gratis con herramientas

# Opcionales
# PORT=3000
# PRECIO_MODELO=claude-opus-5-5
# PRECIO_ESFUERZO=low   # low (más rápido) | medium | high (más preciso)

# Gravity (npm run gravity), opcionales
# BOTS_PUERTO=3001
# BOTS_HOST=127.0.0.1   # solo esta máquina; ver bots/README.md antes de cambiarlo
# BOTS_DATOS=~/gravity
# BOTS_MODELO=claude-opus-5-5
# BOTS_ESFUERZO=medium  # low | medium | high
