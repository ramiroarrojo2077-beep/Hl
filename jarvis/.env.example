# ===== Lo mínimo (gratis) =====
# IA principal: Gemini. Clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Respaldo + oído (Whisper): Groq. Clave gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Cómo te llama Jarvis y dónde estás (para clima y noticias)
JARVIS_USUARIO=Ramiro
JARVIS_CIUDAD=Buenos Aires
JARVIS_PAIS=AR

# ===== Voz natural (opcional) =====
# https://elevenlabs.io → Profile → API Keys. Plan gratis: ~10.000 caracteres/mes.
ELEVENLABS_API_KEY=
# Vacío = elige sola una voz femenina en español de tu cuenta. Listado: http://localhost:3700/api/voces
ELEVENLABS_VOZ=
# ELEVENLABS_MODELO=eleven_flash_v2_5

# ===== Correo (Gmail, Yahoo, iCloud…) =====
# Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords
# Varias cuentas separadas por coma:  yo@gmail.com:abcdabcdabcdabcd,otra@gmail.com:efghefghefghefgh
EMAIL_CUENTAS=

# ===== WhatsApp =====
# 1 = vincular tu WhatsApp (escaneás un QR desde la interfaz, como WhatsApp Web)
WHATSAPP_ACTIVO=0
# 1 = también avisar mensajes de grupos
WHATSAPP_GRUPOS=0

# ===== Telegram (para que Jarvis te encuentre fuera de casa) =====
# Creá un bot con @BotFather y pegá el token. Después escribile al bot: te dice tu chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Celular y acceso desde otros dispositivos =====
# Para usar la app de Android: 0.0.0.0 + un token largo inventado por vos.
# JARVIS_HOST=0.0.0.0
# JARVIS_TOKEN=
# PORT=3700

# ===== Opcionales =====
# Resumen de buenos días a esta hora (HH:MM)
# JARVIS_RESUMEN_DIARIO=08:00
# Desde qué importancia te avisa en voz alta: baja | media | alta
# JARVIS_AVISAR_DESDE=media
# Búsqueda web más precisa (gratis 1000/mes): https://tavily.com
# TAVILY_API_KEY=
# Más proveedores de IA de respaldo
# OPENROUTER_API_KEY=
# OPENROUTER_MODELO=
# OLLAMA_MODELO=llama3.1:8b
# JARVIS_PROVEEDORES=gemini,groq,openrouter,ollama
# GEMINI_MODELO=gemini-flash-latest
# GROQ_MODELO=openai/gpt-oss-120b
# low | medium | high
# JARVIS_RAZONAMIENTO=low

# ===== App de escritorio =====
# vertical (panel al costado) | completo (HUD de pantalla completa)
# JARVIS_PANEL=vertical
# JARVIS_LADO=derecha
# JARVIS_ANCHO=440
# JARVIS_SIEMPRE_ARRIBA=0
