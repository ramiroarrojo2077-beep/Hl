<?xml version="1.0" encoding="utf-8"?>
<!--
  Gravity corre en tu compu y en la Wi-Fi de casa se entra por http://192.168.x.x:3001,
  así que hace falta permitir HTTP sin cifrar. Fuera de casa conviene HTTPS
  (Tailscale o un túnel de Cloudflare): ver bots/MOVIL.md.
  Solo se confía en las autoridades de certificación del sistema.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
