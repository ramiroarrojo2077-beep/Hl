<?xml version="1.0" encoding="utf-8"?>
<!-- Atajo al mantener apretado el ícono de la app: cambiar la dirección de tu Gravity. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_atajo_direccion"
        android:shortcutId="cambiar_direccion"
        android:shortcutLongLabel="@string/atajo_largo"
        android:shortcutShortLabel="@string/atajo_corto">
        <intent
            android:action="ar.gravity.app.CAMBIAR_DIRECCION"
            android:targetClass="ar.gravity.app.MainActivity"
            android:targetPackage="ar.gravity.app" />
    </shortcut>
</shortcuts>
