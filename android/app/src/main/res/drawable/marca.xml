<?xml version="1.0" encoding="utf-8"?>
<!-- Marca de Gravity, "G en órbita" (grilla de 32): tres cuartos de órbita que bajan al centro como el travesaño de una G, el manager al centro y un compañero cian a la 1:30. Misma geometría que bots/public/iconos/gravity.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">
    <!-- órbita y travesaño -->
    <path
        android:pathData="M16 6A10 10 0 1 0 26 16H16"
        android:strokeColor="@color/texto"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- el manager -->
    <path
        android:pathData="M12 16a4 4 0 1 0 8 0a4 4 0 1 0 -8 0Z"
        android:fillColor="@color/texto" />
    <!-- el compañero -->
    <path
        android:pathData="M20 9a3 3 0 1 0 6 0a3 3 0 1 0 -6 0Z"
        android:fillColor="@color/cian" />
</vector>
