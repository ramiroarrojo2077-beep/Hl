<?xml version="1.0" encoding="utf-8"?>
<!-- Lengüeta pegada al borde derecho: se ve apenas y no tapa lo que hay en la pantalla.
     La parte transparente de la izquierda agranda la zona que se puede tocar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#336CD3F0">
    <item android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2111827" />
            <stroke
                android:width="1dp"
                android:color="@color/linea" />
            <corners
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="12dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>
</ripple>
