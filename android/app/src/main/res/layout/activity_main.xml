<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo" />

    <!-- Sin conexión -->
    <ScrollView
        android:id="@+id/panelError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.9"
                android:importantForAccessibility="no"
                android:src="@drawable/marca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/error_titulo"
                android:textColor="@color/texto"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/errorDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="420dp"
                android:text="@string/error_red"
                android:textColor="@color/texto2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/errorDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/texto3"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/botonReintentar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/boton_primario"
                android:fontFamily="sans-serif-medium"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/reintentar"
                android:textAllCaps="false"
                android:textColor="@color/sobre_primario"
                android:textSize="16sp" />

            <Button
                android:id="@+id/botonCambiarDesdeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/boton_secundario"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/cambiar_direccion"
                android:textAllCaps="false"
                android:textColor="@color/texto"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Dirección del servidor: primera vez y "Cambiar dirección" -->
    <ScrollView
        android:id="@+id/panelDireccion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:src="@drawable/marca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/direccion_titulo"
                android:textColor="@color/texto"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/direccion_ayuda"
                android:textColor="@color/texto2"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/campoDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_campo"
                android:contentDescription="@string/direccion_campo_descripcion"
                android:fontFamily="monospace"
                android:hint="@string/direccion_pista"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="52dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto3"
                android:textCursorDrawable="@null"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/avisoDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/calido_texto"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/botonConectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/boton_primario"
                android:fontFamily="sans-serif-medium"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/conectar"
                android:textAllCaps="false"
                android:textColor="@color/sobre_primario"
                android:textSize="16sp" />

            <Button
                android:id="@+id/botonCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/boton_secundario"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="@string/cancelar"
                android:textAllCaps="false"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:text="@string/ejemplos"
                android:textAllCaps="true"
                android:textColor="@color/texto3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ejemploWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_ejemplo"
                android:fontFamily="monospace"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/ejemplo_wifi"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ejemplo_wifi_nota"
                android:textColor="@color/texto3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ejemploTailscale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fondo_ejemplo"
                android:fontFamily="monospace"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/ejemplo_tailscale"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ejemplo_tailscale_nota"
                android:textColor="@color/texto3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/direccion_seguridad"
                android:textColor="@color/texto3"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Botón flotante: menú con Recargar, Cambiar dirección y Abrir en el navegador -->
    <ImageButton
        android:id="@+id/manija"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:alpha="0.85"
        android:background="@drawable/fondo_manija"
        android:contentDescription="@string/manija_descripcion"
        android:elevation="6dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/marca"
        android:visibility="gone" />

    <!-- Progreso de carga (cian = actividad) -->
    <ProgressBar
        android:id="@+id/progreso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/cian"
        android:visibility="gone" />
</FrameLayout>
