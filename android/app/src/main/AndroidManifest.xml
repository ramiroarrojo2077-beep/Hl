<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- El motor corre como servicio en primer plano para seguir trabajando con la app cerrada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mantiene la CPU despierta solo mientras hay trabajo en marcha. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Volver a prender el motor al reiniciar el celular y despertarlo para las rutinas. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gravity">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Node.js en su propio proceso: si el motor se cae, la pantalla sigue viva y lo vuelve a prender. -->
        <service
            android:name=".Motor"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":motor">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Motor local de asistentes de IA que trabajan en segundo plano y corren rutinas programadas por el usuario" />
        </service>

        <!-- Lee WhatsApp y las redes por las notificaciones. En el proceso del motor para compartir
             el token. Exportado con el permiso del sistema: solo Android se liga a este servicio. -->
        <service
            android:name=".Escucha"
            android:exported="true"
            android:label="@string/mensajeria_servicio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:process=":motor">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Recibe lo que compartís a Gravity desde otras apps. Translúcida: trabaja y abre la app. -->
        <activity
            android:name=".Compartir"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/compartir_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Alarma de las rutinas: no exportado, solo la dispara la propia app. -->
        <receiver
            android:name=".DespertadorRutina"
            android:exported="false"
            android:process=":motor" />

        <!-- Exportado solo para recibir los avisos del sistema (arranque y actualización, que otras apps no pueden mandar). -->
        <receiver
            android:name=".Despertador"
            android:exported="true"
            android:process=":motor">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
