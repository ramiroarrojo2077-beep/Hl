[
 {
  "key": "whatsapp.open_chat",
  "name": "Preparar WhatsApp",
  "description": "Prepara un mensaje y abre WhatsApp con el texto listo (Click to Chat). El envío lo confirma el usuario dentro de WhatsApp.",
  "category": "communication",
  "risk": "EXTERNAL_COMMUNICATION",
  "operation": "comunicación",
  "executor": "device",
  "params": {
   "recipient_query": {
    "type": "string",
    "maxLength": 120
   },
   "phone": {
    "type": "string",
    "maxLength": 20
   },
   "contact_label": {
    "type": "string",
    "maxLength": 120
   },
   "text": {
    "type": "string",
    "maxLength": 4000
   },
   "tone": {
    "type": "string",
    "enum": [
     "original",
     "informal",
     "formal",
     "amistoso",
     "breve",
     "profesional",
     "explicativo"
    ]
   }
  },
  "required": [],
  "android_permissions": [],
  "always_confirm": true,
  "result_states": [
   "DRAFT_CREATED",
   "CONTACT_RESOLVED",
   "AWAITING_CONFIRMATION",
   "READY_TO_OPEN",
   "WHATSAPP_OPENED",
   "CANCELLED",
   "ERROR"
  ],
  "notes": "NEXUS nunca informa 'enviado': abrir WhatsApp no es enviar. El número se resuelve en el teléfono."
 },
