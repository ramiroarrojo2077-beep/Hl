 {
  "key": "whatsapp.business_send",
  "name": "Enviar por WhatsApp Business",
  "description": "Envía un mensaje por la API oficial de WhatsApp Business Platform (credenciales solo en el servidor).",
  "category": "communication",
  "risk": "EXTERNAL_COMMUNICATION",
  "operation": "comunicación",
  "executor": "server",
  "params": {
   "phone": {
    "type": "string",
    "maxLength": 20
   },
   "text": {
    "type": "string",
    "maxLength": 4096
   },
   "template_name": {
    "type": "string",
    "maxLength": 120
   },
   "template_language": {
    "type": "string",
    "maxLength": 12
   },
   "template_params": {
    "type": "array"
   },
   "opt_in_confirmed": {
    "type": "boolean"
   },
   "contact_label": {
    "type": "string",
    "maxLength": 120
   }
  },
  "required": [
   "phone"
  ],
  "android_permissions": [],
  "always_confirm": true,
  "result_states": [
   "ACCEPTED",
   "SENT",
   "DELIVERED",
   "READ",
   "FAILED"
  ],
  "notes": "Los estados vienen de la API y sus webhooks; nunca se infieren."
 }
