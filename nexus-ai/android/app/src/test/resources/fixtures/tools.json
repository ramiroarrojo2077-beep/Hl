 {
  "key": "memory.propose",
  "name": "Proponer recuerdo",
  "description": "Propone guardar un conocimiento útil y duradero (no datos triviales). Queda como no verificado hasta que el usuario lo revise. Indicá confianza (0-1) y fuente si existe.",
  "category": "memoria",
  "operation_class": "creation",
  "parameters_schema": {
   "type": "object",
   "required": [
    "content"
   ],
   "properties": {
    "kind": {
     "enum": [
      "fact",
      "decision",
      "experience",
      "error",
      "preference",
      "learning",
      "result"
     ],
     "type": "string"
    },
    "scope": {
     "enum": [
      "agent",
      "shared",
      "user",
      "project"
     ],
     "type": "string"
    },
    "title": {
     "type": "string",
     "maxLength": 200
    },
    "content": {
     "type": "string",
     "maxLength": 4000
    },
    "confidence": {
     "type": "number"
    },
    "source_ref": {
     "type": "string",
     "maxLength": 500
    }
   },
   "additionalProperties": false
  },
  "requires_plugin": null,
  "is_enabled": true
 },
