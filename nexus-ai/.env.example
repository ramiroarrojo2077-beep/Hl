# ===== NEXUS AI — configuración del servidor =====
# Generá los secretos con: ./scripts/gen-secrets.sh

NEXUS_ENV=development              # development | production
NEXUS_SECRET_KEY=                  # firma de tokens JWT (≥ 32 caracteres aleatorios)
NEXUS_ENCRYPTION_KEYS=             # clave(s) Fernet para cifrar API keys; separadas por coma para rotar
NEXUS_LOG_LEVEL=INFO
NEXUS_ALLOW_REGISTRATION=true      # poné false después de crear tu cuenta

# Base de datos (docker compose arma NEXUS_DATABASE_URL con estos valores)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=                 # obligatorio en producción
POSTGRES_DB=nexus

# Producción
NEXUS_DOMAIN=                      # p. ej. nexus.midominio.com (Caddy emite el certificado HTTPS)
NEXUS_REQUIRE_HTTPS=false
NEXUS_CORS_ORIGINS=

# Worker y límites
NEXUS_WORKER_CONCURRENCY=4
NEXUS_MAX_TASKS_PER_MISSION=12
NEXUS_MAX_AGENT_STEPS=8

# Sandbox de código (requiere Docker en el host del worker)
NEXUS_SANDBOX_ENABLED=true

# Notificaciones push (Firebase Cloud Messaging HTTP v1): ruta al JSON de la cuenta de servicio
NEXUS_FCM_SERVICE_ACCOUNT_FILE=

# Las API keys de los proveedores de IA NO van acá: se cargan desde la app
# (Ajustes > Proveedores de IA) y se guardan cifradas en la base de datos.
