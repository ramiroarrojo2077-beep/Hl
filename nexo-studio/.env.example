# Copiar este archivo como .env y completar solo los servicios que uses.
# NEXO por defecto solo escucha en 127.0.0.1 por seguridad.
HOST=127.0.0.1
PORT=3377
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434

# Para OAuth de Gmail + Google Calendar + Google Drive (Google Cloud Console)
# Tipo de cliente: Aplicación web
# Authorized redirect URI: http://127.0.0.1:3377/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: otro motor de IA compatible con API de chat/completions.
# AI_BASE_URL=https://tu-servidor.example/v1
# AI_API_KEY=

# Para exponer a otros dispositivos, usá un proxy HTTPS y un token difícil de adivinar.
# No publiques Node directamente sin TLS, autenticación ni límites de velocidad.
# HOST=0.0.0.0
# NEXO_ACCESS_TOKEN=

# WhatsApp Business Cloud API oficial (chats individuales; no WhatsApp personal/grupos)
# Configurar en Meta for Developers; estos valores no van en el HTML ni en la APK.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v23.0
# Webhook publico: https://TU_DOMINIO/api/whatsapp/webhook
